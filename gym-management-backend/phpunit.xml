<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <!-- Separate database: tests wipe it. Never point this at asian_gym. -->
        <env name="DB_DATABASE" value="asian_gym_test" force="true"/>
        <!-- Fake VFT settings: tests never reach the real server (Http::fake). -->
        <env name="VFT_MODE" value="off" force="true"/>
        <env name="VFT_BASE_URL" value="https://vft.test" force="true"/>
        <env name="VFT_EMAIL" value="gym@example.test" force="true"/>
        <env name="VFT_PASSWORD" value="s3cret-test-pw" force="true"/>
        <env name="VFT_DEFAULT_DEVICE_SN" value="TESTSN001" force="true"/>
        <env name="VFT_RETRY_SLEEP_MS" value="0" force="true"/>
    </php>
</phpunit>
